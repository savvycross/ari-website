# Copy to .env.local and fill in.
# Public site URL (used for social previews and the sitemap)
NEXT_PUBLIC_SITE_URL=
# Optional. Leave empty and the contact form emails perearilda@gmail.com via FormSubmit.
# To use another service instead, put its endpoint here, e.g. https://formspree.io/f/xxxxxxx
NEXT_PUBLIC_FORM_ENDPOINT=
